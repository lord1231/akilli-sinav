APP_NAME=Akilli Sinav API
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTGRES_DB=akilli_sinav
POSTGRES_USER=sinav_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://sinav_user:replace-with-a-long-random-database-password@localhost:5432/akilli_sinav
API_PORT=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_BASE_URL=https://your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-14-chars
ADMIN_FULL_NAME=Sistem Yöneticisi

# Açılışta eksik müfredat dosyalarını otomatik yükle (true/false)
AUTO_IMPORT_CURRICULUM=true

# Süresi dolan sınavları sunucu bu aralıkla (saniye) kendisi sonuçlandırır. 0 = kapalı.
EXAM_SWEEP_INTERVAL_SECONDS=60

# true yapılırsa onaylı soru havuzunda öğrencinin görmediği 25 soru varsa Gemini çağrılmaz (maliyet/hız).
REUSE_REVIEWED_QUESTIONS=false

# Siteyi Nginx/Caddy/Cloudflare arkasında yayınlıyorsanız gerçek kullanıcı IP'sini okumak için açın.
# Proxy API'ye doğrudan bağlıysa ve 8000 portu internete kapalıysa "*" kullanılabilir.
# FORWARDED_ALLOW_IPS=*

