# Application
APP_NAME=Akilli Sinav API
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+psycopg://sinav_user:change_me@localhost:5432/akilli_sinav

# Google Gemini (keep the real key only in your local/cloud secret settings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email (configure later)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
